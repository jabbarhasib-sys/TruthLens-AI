# =============================================
# TruthLens AI - Environment Configuration
# Copy to .env and fill in your keys.
# =============================================

# App
PROJECT_NAME=TruthLens AI API

# Security
JWT_SECRET=change-me-to-a-long-random-secret

# Token Expiry (in minutes — default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================
# Database
# =============================================
# Local (SQLite)
DATABASE_URL=sqlite:///./truthlens.db

# Managed PostgreSQL (Render / Supabase / Railway)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# =============================================
# Redis (optional — leave blank if not using)
# =============================================
# REDIS_URL=rediss://default:password@host:6379

# =============================================
# API Keys — paste your keys below
# =============================================

# Groq API (LLM inference) — https://console.groq.com
GROQ_API_KEY=

# Google Gemini / Vision API — https://console.cloud.google.com
GOOGLE_API_KEY=

# Google Application Credentials (path to service account JSON, if needed)
GOOGLE_APPLICATION_CREDENTIALS=

# NewsAPI — https://newsapi.org
NEWS_API_KEY=

# Mediastack News API — https://mediastack.com
MEDIASTACK_API_KEY=

# Hive Moderation AI (AI-generated image detection) — https://hive.moderationhives.com
HIVE_API_KEY=